# Copy to .env and fill in what you have. Never commit .env.
#
# Every setting is optional. With NO .env at all the server runs a complete demo: fixtures mode, the built-in PayPal
# simulator, an embedded database and development signing keys. Add values only to switch a part to the real service.
# Variables already set in the environment win over this file. See docs/setup.md.

# --- Mode -------------------------------------------------------------
# fixtures = built-in catalog and a rule-following agent (no model calls). Default.
# live     = real Anthropic + Channel3 calls (needs both keys below)
WARRANT_MODE=fixtures
NODE_ENV=development
# Where the server and the web app are reached. Defaults suit `pnpm dev`; in production the web app is served by the
# server, so WEB_ORIGIN defaults to PUBLIC_BASE_URL (which defaults to Render's RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
# PORT=8787
# MERCHANT_NAME=Warrant Demo Store (sandbox)

# --- PayPal (SANDBOX ONLY) -------------------------------------------
# simulator = the built-in stand-in; needs nothing. Default when PAYPAL_CLIENT_ID is empty.
# sandbox   = the real PayPal sandbox; needs the four values below. Production is refused.
# Check them with: pnpm paypal:doctor
PAYPAL_ENV=simulator
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PayPal merchant id of the sandbox Business account (used in the warrant audience)
PAYPAL_MERCHANT_ID=
# Only needed if you use the sandbox create-dispute API (see docs/paypal-integration.md)
PAYPAL_AUTH_ASSERTION_JWT=

# --- Models -----------------------------------------------------------
# Only for WARRANT_MODE=live.
ANTHROPIC_API_KEY=
# Use current Claude model IDs from the Anthropic docs.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# --- Catalog ----------------------------------------------------------
# Only for WARRANT_MODE=live.
CHANNEL3_API_KEY=

# --- Database ---------------------------------------------------------
# Empty: an embedded database in DATA_DIR. Set: Postgres (docker compose up -d db gives this one).
# TLS is used for hosts that are not this machine or a private name; add ?sslmode=disable or ?sslmode=verify-full to decide.
DATABASE_URL=
# DATABASE_URL=postgres://warrant:warrant@localhost:5432/warrant
# Where the embedded database and development keys live. Default: your user data folder, NOT the repository
# (a OneDrive- or Dropbox-synced folder cannot host the embedded database).
# DATA_DIR=

# --- Signing keys (base64 Ed25519 private keys; generate with: pnpm keygen) ---
# Empty: development keys are created in DATA_DIR. Required in production.
WALLET_SIGNING_KEY=
AGENT_PLATFORM_SIGNING_KEY=
REGISTRY_LOG_KEY=

# --- AG Studio (optional) ---------------------------------------------
# Local development needs no key. A trial licence removes the watermark in production builds.
# This value is embedded in the client bundle; it is not a secret.
VITE_AG_STUDIO_LICENCE_KEY=

# --- Dispute agent ----------------------------------------------------
# Money-moving actions need merchant approval unless this is "true" (sandbox demo only).
DISPUTE_AUTOPILOT=false

# --- Console and Lab access --------------------------------------------
# true  = the merchant console and Dispute Lab are open to anyone who reaches the server (a demo).
# false = they need CONSOLE_TOKEN, sent as the x-console-token header (the console asks for it).
JUDGE_MODE_ENABLED=true
CONSOLE_TOKEN=

# --- Hosted-demo safety ----------------------------------------------
LLM_DAILY_BUDGET_USD=20
LLM_RUNS_PER_VISITOR=15

# --- Other tools -----------------------------------------------------
# MCP server (packages/mcp): WARRANT_API_URL=http://localhost:8787   WARRANT_CONSOLE_TOKEN=
